# ===== Used by scripts/setup.sh on your VM =====
SERVER_URL=https://YOUR-EVOLUTION-SERVICE.up.railway.app
AUTHENTICATION_API_KEY=same_value_as_on_railway_evolution_service
INSTANCE_NAME=byit-ops
WEBHOOK_TOKEN=same_value_as_on_railway_receiver_service
# Railway private address of the receiver service (service must be named "receiver")
RECEIVER_INTERNAL_URL=http://receiver.railway.internal:8000

# ===== Set these on the Railway "receiver" service (not needed on the VM) =====
# WEBHOOK_TOKEN=...
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# ALLOWED_GROUPS=            # optional, comma-separated group JIDs
# DB_PATH=/data/messages.db  # volume mounted at /data
# --- inventory web app (receiver service) ---
# APP_PASSWORD=...                # login password for the web app (required to open it)
# SESSION_SECRET=...              # optional; long random string, signs login cookies
# EVOLUTION_URL=https://YOUR-EVOLUTION-SERVICE.up.railway.app
# EVOLUTION_API_KEY=...           # same value as AUTHENTICATION_API_KEY on the Evolution service
# EVOLUTION_INSTANCE=byit-ops       # instance whose chats feed the app (others are ignored)
# MARKET=eg                        # eg (default, EGP, price per sq m) or uae (AED, price per sq ft)
